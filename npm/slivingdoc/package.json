{
  "name": "slivingdoc",
  "version": "0.1.3",
  "description": "Launcher for the slivingdoc MCP notebook server: selects, downloads, verifies, and runs the native slivingdoc binary for this platform.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baalimago/slivingdoc.git"
  },
  "type": "module",
  "bin": {
    "slivingdoc": "bin/slivingdoc.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check-release": "node scripts/check-release.mjs",
    "prepublishOnly": "node scripts/check-release.mjs"
  },
  "keywords": [
    "mcp",
    "notebook",
    "s3",
    "slivingdoc"
  ]
}
